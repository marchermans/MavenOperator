## NGINX configuration for a Proxy Maven repository.
## Rendered by NginxConfigRenderer using Scriban.
## Variables: name, var_name, download_policy, upstream_scheme_host, upstream_path, cache_ttl, upstream_auth_header,
##            metrics_enabled, stub_status_port, download_auth_proxy_enabled,
##            path_prefix, location_path_prefix, path_prefix_regex
##
## 'name'     — the Kubernetes resource name, used in URL paths and auth realm strings.
##              May contain hyphens (e.g. "my-proxy").
## 'var_name' — name sanitised for NGINX identifiers (hyphens → underscores, e.g. "my_proxy").
## 'download_auth_proxy_enabled' — true if download auth uses proxy (ciTrust/acls).
##
## The proxy caches upstream responses in an emptyDir (or PVC) volume at /var/cache/nginx/<name>.

# ── Maven coordinate extraction (http context) ─────────────────────────────
map $uri $maven_repo_{{ var_name }} {
    default "{{ name }}";
}

map $uri $maven_artifact_group_{{ var_name }} {
    ~^{{ path_prefix_regex }}(?P<g>(?:[^/]+/)+)[^/]+/[^/]+/[^/]+$  $g;
    default "-";
}

map $uri $maven_artifact_id_{{ var_name }} {
    ~^{{ path_prefix_regex }}(?:[^/]+/)+(?P<a>[^/]+)/[^/]+/[^/]+$  $a;
    default "-";
}

map $uri $maven_artifact_version_{{ var_name }} {
    ~^{{ path_prefix_regex }}(?:[^/]+/)+[^/]+/(?P<v>[^/]+)/[^/]+$  $v;
    default "-";
}

map $uri $maven_asset_type_{{ var_name }} {
    ~\.jar$                 jar;
    ~\.war$                 war;
    ~\.aar$                 aar;
    ~\.pom$                 pom;
    ~maven-metadata\.xml$   metadata;
    ~\.(sha1|md5|sha256)$   checksum;
    default                 other;
}

# Downstream cache-control policy:
# metadata should be revalidated, immutable artifact blobs can be cached for longer.
map $uri $maven_cache_control_{{ var_name }} {
    ~maven-metadata\.xml$     "no-cache, must-revalidate";
    default                    "public, max-age=3600";
}

# ── Per-request upstream URL (http context) ──────────────────────────────────
# The full target URL is computed here because:
#   * proxy_pass with variables cannot do prefix substitution (it replaces the
#     entire request URI), and
#   * a plain `rewrite ... break;` in this location is silently suppressed for
#     methods NOT listed in limit_except (PUT/DELETE) on this nginx build.
# A map is evaluated per-request regardless of method, so reads AND uploads are
# mapped identically: the location prefix is stripped and upstream_path prepended.
map $uri $rs_up_url_{{ var_name }} {
    ~^{{ path_prefix_regex }}(?<r>.*)  "{{ upstream_scheme_host }}{{ upstream_path }}/$r";
    default                           "{{ upstream_scheme_host }}{{ upstream_path }}/";
}

{{ if upload_enabled -}}
# ── Per-method upstream credentials for upload forwarding (http context) ────
# 'map' only works in the http context, so it cannot live inside the location's
# limit_except block. Reads keep their original Authorization header (or the
# static read credential when one is configured); write methods get the upload
# credential. This nginx build requires a leading '$' on the map target name.
{{ if upstream_upload_auth_header != "" -}}
map $request_method $rs_up_auth_{{ var_name }} {
    {{ if upstream_auth_header != "" -}}default "{{ upstream_auth_header }}";{{ else -}}default $http_authorization;{{ end -}}
    PUT    "{{ upstream_upload_auth_header }}";
    DELETE "{{ upstream_upload_auth_header }}";
    MKCOL  "{{ upstream_upload_auth_header }}";
}
{{ else if upstream_auth_header != "" -}}
map $request_method $rs_up_auth_{{ var_name }} {
    default "{{ upstream_auth_header }}";
    PUT    "{{ upstream_auth_header }}";
    DELETE "{{ upstream_auth_header }}";
    MKCOL  "{{ upstream_auth_header }}";
}
{{ end -}}
{{ end -}}

# ── JSON access log format ──────────────────────────────────────────────────
log_format maven_json_{{ var_name }} escape=json
    '{'
    '"time":"$time_iso8601",'
    '"repo":"$maven_repo_{{ var_name }}",'
    '"method":"$request_method",'
    '"path":"$request_uri",'
    '"artifact_group":"$maven_artifact_group_{{ var_name }}",'
    '"artifact_id":"$maven_artifact_id_{{ var_name }}",'
    '"artifact_version":"$maven_artifact_version_{{ var_name }}",'
    '"asset_type":"$maven_asset_type_{{ var_name }}",'
    '"status":$status,'
    '"bytes_sent":$bytes_sent,'
    '"request_time":$request_time,'
    '"cache_status":"$upstream_cache_status",'
    '"upstream_rt":"$upstream_response_time",'
    '"remote_addr":"$remote_addr"'
    '}';

# Cache path uses the filesystem path (hyphens OK); keys_zone name must be a valid NGINX identifier.
proxy_cache_path /var/cache/nginx/{{ name }}
    levels=1:2
    keys_zone={{ var_name }}_cache:10m
    max_size=10g
    inactive=7d
    use_temp_path=off;

{{ if metrics_enabled -}}
# ── Internal stub_status (scraped by nginx-prometheus-exporter sidecar) ────
server {
    listen {{ stub_status_port }};
    server_name localhost;
    allow 127.0.0.1;
    deny all;

    location /stub_status {
        stub_status;
    }
}
{{ end -}}

server {
    listen 80;

    # Throughput tuning for cached artifact responses.
    sendfile on;
    sendfile_max_chunk 8m;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65s;
    keepalive_requests 10000;
    reset_timedout_connection on;

    # Use the CoreDNS resolver inside the cluster for dynamic hostname resolution.
    resolver kube-dns.kube-system.svc.cluster.local valid=30s ipv6=off;
    resolver_timeout 10s;

    # Health check endpoint — no auth required
    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    {{ if download_auth_proxy_enabled -}}
    # Internal auth subrequest endpoint for maven-auth-proxy sidecar.
    # The proxy inspects X-Original-Method to determine direction (read vs write).
    location = /auth/validate {
        internal;
        proxy_pass http://127.0.0.1:8080/auth/validate;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Original-Uri $request_uri;
        proxy_set_header X-Original-Method $request_method;
    }
    {{ end -}}

    location {{ location_path_prefix }} {
        # ── Download auth (GET/HEAD) ────────────────────────────────────────
        {{ if download_auth_proxy_enabled -}}
        auth_request /auth/validate;
        auth_request_set $maven_auth_role $upstream_http_x_auth_role;
        {{ else if download_policy == "Authenticated" -}}
        auth_basic "Maven Proxy - {{ name }}";
        auth_basic_user_file /etc/nginx/auth/download.htpasswd;
        {{ end -}}

        {{ if metrics_enabled -}}
        access_log /var/log/nginx/access.json maven_json_{{ var_name }};
        {{ end -}}

        # Full per-request URL computed by the map in the http context (see above).
        # Variable-only proxy_pass → the value is used as the complete upstream URL.
        proxy_pass $rs_up_url_{{ var_name }};

        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_ssl_server_name on;
        proxy_ssl_session_reuse off;

        # ── Cache configuration (GET/HEAD only) ─────────────────────────────
        proxy_cache {{ var_name }}_cache;
        proxy_cache_key "$scheme$proxy_host$request_uri";
        proxy_cache_valid 200 206 {{ cache_ttl }};
        proxy_cache_valid 301 302 10m;
        proxy_cache_valid 404      1m;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
        proxy_cache_background_update on;
        proxy_cache_revalidate on;
        proxy_ignore_headers Set-Cookie;

        proxy_cache_methods GET HEAD;

        # ── Upstream auth (reads + uploads via per-method map) ────────────────
        {{ if upload_enabled -}}
        {{ if upstream_upload_auth_header != "" || upstream_auth_header != "" -}}
        proxy_set_header Authorization $rs_up_auth_{{ var_name }};
        {{ end -}}
        {{ else if upstream_auth_header != "" -}}
        # Upload-disabled proxies keep the simple static header.
        proxy_set_header Authorization "{{ upstream_auth_header }}";
        {{ end -}}

        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;

        proxy_pass_header ETag;
        proxy_pass_header Last-Modified;

        add_header Cache-Control $maven_cache_control_{{ var_name }} always;
        add_header X-Maven-Proxy-Cache $upstream_cache_status always;

        client_max_body_size 512m;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;

        # ── Upload forwarding (PUT/DELETE/MKCOL) ────────────────────────────
        {{ if upload_enabled -}}
        # Client auth for uploads. NOTE: only auth_basic* directives are allowed
        # inside limit_except on this nginx build — proxy_set_header, error_page
        # and proxy_cache there make the config fail to load (and suppress the
        # location rewrite for write methods). Upstream credential injection is
        # handled by the per-method map above.
        limit_except GET HEAD OPTIONS {
            {{ if upload_mode == "Passthrough" }}{{ if upload_policy == "Authenticated" -}}
            auth_basic "Maven Upload - {{ name }}";
            auth_basic_user_file /etc/nginx/upload-auth/upload.htpasswd;
            {{ end }}{{ end -}}
        }
        {{ else -}}
        # Upload forwarding disabled → proxy is a read-only cache; reject writes.
        # NOTE: only basic-auth directives may appear inside limit_except on this
        # nginx build, so the read-only gate uses per-method checks below.
        # `if { return ... }` is one of the safe if usages in nginx.
        if ($request_method = PUT)    { return 405; }
        if ($request_method = DELETE) { return 405; }
        if ($request_method = MKCOL)  { return 405; }
        {{ end -}}
    }


}
